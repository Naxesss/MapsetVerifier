<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="ppy.ManagedBass" Version="2022.1216.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MapsetVerifier.Framework\MapsetVerifier.Framework.csproj" />
    <ProjectReference Include="..\MapsetVerifier.Server\MapsetVerifier.Server.csproj" />
    <ProjectReference Include="..\MapsetVerifier.Snapshots\MapsetVerifier.Snapshots.csproj" />
    <ProjectReference Include="..\MapsetVerifier.Logging\MapsetVerifier.Logging.csproj" />
    <ProjectReference Include="..\MapsetVerifier.Checks\MapsetVerifier.Checks.csproj" />
  </ItemGroup>
  <Target
    Name="PruneSidecarPublishOutput"
    AfterTargets="ComputeResolvedFilesToPublishList"
    Condition="'$(SelfContained)' == 'true'"
  >
    <ItemGroup>
      <!--
        Removed, confirmed safe via smoke-testing the published exe (health, difficulty/analyze, runChecks):
          - osu.Game.Resources.dll: embedded game-client media, never loaded by the difficulty/parse path.
          - SDL/veldrid/FFmpeg natives: only loaded by a framework GameHost, which the sidecar never creates.
          - CoreCLR debugger-attach/crash-dump tooling (mscordaccore/mscordbi/createdump/clretwrc) and the
            native PDB symbol reader: irrelevant to app code paths, only used by an attached debugger.
          - ASP.NET Components (Blazor)/Identity/HttpSys: part of the shared framework, unused by this
            Kestrel + MVC-controllers server.
        Do NOT add osuTK.dll, Commons.Music.Midi.dll, or SharpCompress.dll here - removing them breaks
        osu.Game.Beatmaps.Formats.Decoder's static initializer and silently zeroes out star rating.
      -->
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)',
          '^(osu\.Game\.Resources\.dll|(lib)?SDL[23]\.(dll|so|dylib.*)|libveldrid-spirv\.(dll|so|dylib)|(lib)?(avcodec|avformat|avutil|avdevice|avfilter|swscale|swresample)[-.].*|(lib)?mscordaccore(_.*)?\.(dll|so|dylib)|(lib)?mscordbi\.(dll|so|dylib)|(lib)?clretwrc\.(dll|so|dylib)|createdump(\.exe)?|Microsoft\.DiaSymReader\.Native\..*\.dll|Microsoft\.AspNetCore\.Components.*\.dll|Microsoft\.AspNetCore\.Identity\.dll|Microsoft\.Extensions\.Identity\.(Core|Stores)\.dll|Microsoft\.AspNetCore\.Server\.HttpSys\.dll)$'))"
      />
    </ItemGroup>
  </Target>
</Project>
